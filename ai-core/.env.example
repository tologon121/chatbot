# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
# В проде ОБЯЗАТЕЛЬНО используйте SERVICE_ROLE_KEY (bypass RLS).
# Anon/publishable ключ (sb_publishable_...) тоже подойдет ЕСЛИ RLS отключен
# на ваших таблицах (по умолчанию в database.sql RLS отключен).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Альтернативно: одна переменная SUPABASE_KEY (используется как fallback)
# SUPABASE_KEY=sb_publishable_xxx

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- RAG ---
RAG_MATCH_THRESHOLD=0.75
RAG_MATCH_COUNT=4
RAG_TEMPERATURE=0.3

# --- CORS / Security ---
# Через запятую. Можно "*" для разрешения всем доменам встраивать виджет.
ALLOWED_ORIGINS=*

# Лимит запросов в минуту на одну сессию
RATE_LIMIT_PER_MINUTE=30

APP_VERSION=1.1.0
